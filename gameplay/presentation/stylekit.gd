## Shared, original Arcane Academy UI styling. All graphics are generated by
## generate_assets.py; no external anime/game graphics are copied.
class_name ArcaneStyle
extends RefCounted

const INK := Color("#11172d")
const PANEL := Color("#1b243f")
const MID := Color("#303a62")
const GOLD := Color("#f7cd80")
const LAVENDER := Color("#afa5f0")
const TEAL := Color("#6fd7d1")
const PINK := Color("#f292c3")
const WHITE := Color("#f2eff7")
const MUTED := Color("#b9c2db")
const DIR := "res://gameplay/presentation/assets/"


static func background(parent: Node, image_name: String) -> TextureRect:
    var sprite := TextureRect.new()
    sprite.name = "Background"
    sprite.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    sprite.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
    sprite.stretch_mode = TextureRect.STRETCH_SCALE
    sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    sprite.texture = load(DIR + image_name) as Texture2D
    sprite.mouse_filter = Control.MOUSE_FILTER_IGNORE
    parent.add_child(sprite)
    # Pre-layout anchors if this is built in _ready, so size is correct.
    sprite.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    return sprite


static func text(parent: Node, content: String, position: Vector2, box_size: Vector2,
        font_size: int = 20, color: Color = WHITE, center: bool = false) -> Label:
    var label := Label.new()
    label.text = content
    label.position = position
    label.size = box_size
    label.add_theme_color_override("font_color", color)
    label.add_theme_font_size_override("font_size", font_size)
    if center:
        label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
    label.mouse_filter = Control.MOUSE_FILTER_IGNORE
    parent.add_child(label)
    return label


static func card(parent: Node, position: Vector2, card_size: Vector2,
        accent: Color = GOLD, opacity: float = 0.93) -> PanelContainer:
    var panel := PanelContainer.new()
    panel.position = position
    panel.size = card_size
    var sb := StyleBoxFlat.new()
    sb.bg_color = Color(PANEL.r, PANEL.g, PANEL.b, opacity)
    sb.border_width_left = 2
    sb.border_width_right = 2
    sb.border_width_top = 2
    sb.border_width_bottom = 2
    sb.border_color = accent
    sb.corner_radius_top_left = 9
    sb.corner_radius_top_right = 9
    sb.corner_radius_bottom_left = 9
    sb.corner_radius_bottom_right = 9
    panel.add_theme_stylebox_override("panel", sb)
    panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
    parent.add_child(panel)
    return panel


static func button(parent: Node, label: String, position: Vector2,
        button_size: Vector2, accent: Color = TEAL) -> Button:
    var btn := Button.new()
    btn.text = label
    btn.position = position
    btn.custom_minimum_size = button_size
    btn.size = button_size
    btn.focus_mode = Control.FOCUS_ALL
    btn.add_theme_font_size_override("font_size", 19)
    btn.add_theme_color_override("font_color", WHITE)
    btn.add_theme_color_override("font_hover_color", GOLD)
    btn.add_theme_color_override("font_pressed_color", WHITE)
    for state in ["normal", "hover", "pressed", "disabled", "focus"]:
        var style := StyleBoxFlat.new()
        style.bg_color = Color("#273351") if state == "normal" else Color("#435079")
        if state == "pressed":
            style.bg_color = accent.darkened(0.43)
        if state == "disabled":
            style.bg_color = Color("#22273a")
        if state == "focus":
            style.bg_color = Color(0, 0, 0, 0)
        style.border_color = accent if state in ["normal", "pressed"] else GOLD
        if state == "disabled":
            style.border_color = Color("#57607c")
        for side in ["border_width_left", "border_width_top", "border_width_right", "border_width_bottom"]:
            style.set(side, 2)
        for side in ["corner_radius_top_left", "corner_radius_top_right", "corner_radius_bottom_left", "corner_radius_bottom_right"]:
            style.set(side, 6)
        style.content_margin_left = 12
        style.content_margin_right = 12
        btn.add_theme_stylebox_override(state, style)
    parent.add_child(btn)
    return btn


static func portrait(parent: Node, kind: String, position: Vector2, display_size: Vector2) -> TextureRect:
    var pic := TextureRect.new()
    pic.position = position
    pic.size = display_size
    pic.texture = load(DIR + "portrait_%s.png" % kind) as Texture2D
    pic.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    pic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
    pic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
    pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
    parent.add_child(pic)
    return pic
